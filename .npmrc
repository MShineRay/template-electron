electron_mirror=https://npmmirror.com/mirrors/electron/

# ============================================
# pnpm 与 Electron 兼容性配置
# ============================================
# 使用 hoisted 链接器（类似 npm/yarn 的扁平化结构）
# 这是解决 Electron 与 pnpm 兼容性问题的关键配置
node-linker=hoisted

# 提升所有依赖到根 node_modules（类似 npm/yarn）
# 确保 Electron 二进制文件可以被正确找到
shamefully-hoist=true

# 确保 Electron 相关包被提升到公共位置
public-hoist-pattern[]=*electron*

# 允许运行 pre/post 安装脚本
# Electron 需要在 postinstall 中下载二进制文件
enable-pre-post-scripts=true

# 放宽 peer dependencies 检查
strict-peer-dependencies=false

# 禁用副作用缓存（某些情况下可能导致问题）
side-effects-cache=false