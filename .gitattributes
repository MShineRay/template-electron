# 自动检测文本文件并规范化行尾
* text=auto

# 明确声明你希望始终规范化并转换为本机行尾的文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# 明确声明二进制文件（所有其他文件）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.dmg binary
*.exe binary
*.deb binary
*.rpm binary
*.AppImage binary

# 防止意外合并的文件
package-lock.json merge=ours
pnpm-lock.yaml merge=ours
yarn.lock merge=ours

